LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
SQLITE_PATH=./salarybot.db
MAX_REQUESTS_PER_DAY=10

# ── WhatsApp Business Cloud API (optional) ────────────────────────────────────
# Only required when using the WhatsApp channel (/webhook endpoints).
# Leave blank to run in in-app chat mode only (/app/message and /app/upload).
# From Meta Developer Console → Your App → WhatsApp → API Setup
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=

# Choose any secret string — must match what you enter in the Meta webhook config
WA_VERIFY_TOKEN=your_verify_token_here

# Leave as-is unless Meta releases a newer version
WA_API_VERSION=v19.0
